# Canonical production URL used by metadata, structured data and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-final-domain.com

# Create this key in the Web3Forms dashboard and enable hCaptcha for the form.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
